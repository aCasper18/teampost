# Alle Einträge sind optional. Kopieren nach .env und anpassen.

# Name und Farbe (Hex) der Oberfläche – Werte mit # oder Leerzeichen in Anführungszeichen
APP_NAME="Teampost"
APP_FARBE="#2563EB"

# Port und Adresse
PORT=3000
HOST=0.0.0.0

# Wo Datenbank, Anhänge und Schlüssel liegen (Standard: ./data)
# DATA_DIR=/var/lib/teampost

# Sitzungs-Geheimnis. Leer = wird beim ersten Start erzeugt und in DATA_DIR/geheimnis.txt gespeichert.
# JWT_SECRET=

# Schlüssel für die Verschlüsselung der Postfach-Passwörter. Leer = aus JWT_SECRET abgeleitet.
# ACHTUNG: Nach dem Einrichten nicht mehr ändern, sonst müssen alle Postfach-Passwörter neu eingegeben werden.
# MAIL_SCHLUESSEL=

# Hinter einem HTTPS-Reverse-Proxy (Caddy, nginx, Traefik):
# COOKIE_SECURE=true
# TRUST_PROXY=true

# Kontakt für Web-Push (Pflichtangabe der Push-Dienste)
VAPID_KONTAKT=mailto:admin@example.com
